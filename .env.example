# Execução local
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
NODE_ENV=development
# Ligação PostgreSQL do Supabase (use a palavra-passe codificada, p. ex. @ -> %40)
DATABASE_URL=postgresql://postgres.PROJECTO:PALAVRA_PASSE@aws-0-REGIAO.pooler.supabase.com:6543/postgres
UPLOAD_DIR=./uploads
SESSION_HOURS=12
MAX_UPLOAD_MB=10
CONTACT_EMAIL=geral@ismma.ac.mz
TRUST_PROXY=false
# Obrigatória para cifrar tokens de recuperação/verificação e a fila de email.
MAIL_QUEUE_KEY=coloque-aqui-uma-chave-aleatoria-com-32-ou-mais-caracteres

# SMTP e SMS são opcionais; sem eles as mensagens ficam na fila.
# SMTP_HOST=smtp.exemplo.mz
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=portal@ismma.ac.mz
# SMS_WEBHOOK_URL=https://exemplo.mz/sms
# SMS_API_KEY=

# Vercel
# UPLOAD_DIR é ignorado: os anexos ficam em /tmp/ismma e são apagados a cada
# arranque a frio. Configure DATABASE_URL e APP_URL nas variáveis do projecto.
