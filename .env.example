# Execução local
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
NODE_ENV=development
DB_FILE=./data/ismma.sqlite
UPLOAD_DIR=./uploads
DEMO_SEED=true
DEMO_PASSWORD=Demonstracao@2026
SESSION_HOURS=12
MAX_UPLOAD_MB=10
CONTACT_EMAIL=geral@ismma.ac.mz
TRUST_PROXY=false
# Para produção local: NODE_ENV=production, domínio HTTPS e DEMO_SEED=false.

# Vercel
# DB_FILE e UPLOAD_DIR são ignorados: na Vercel a base e os anexos ficam em /tmp/ismma
# e são apagados a cada arranque a frio. Defina APP_URL com o domínio público.
# DEMO_SEED=true repõe as contas fictícias nesse arranque; use DEMO_SEED=false apenas
# com armazenamento persistente externo (não incluído neste projecto).
